# apps/web/.env.example -> .env.local olarak kopyala (gerekiyorsa).
#
# Yerel geliştirmede GEREKLİ DEĞİL: vite.config.ts içindeki proxy,
# /api isteklerini otomatik olarak http://localhost:3000'e yönlendirir.
# Bu değişken yalnızca üretimde (Vercel) kullanılır — orada sunucu
# tarafı (loader) istekleri doğrudan API'nin adresine gider, tarayıcı
# proxy'si yoktur.

# apps/web/app/lib/api.ts -> serverFetch() bu adresi kullanır.
API_URL="http://localhost:3000"
