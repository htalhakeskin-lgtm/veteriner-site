{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2023",
    "lib": ["ES2023"],
    "moduleResolution": "node",
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["src/*"]
    }
  },
  // prisma/ bilerek disarida birakildi: include icine alinirsa TypeScript
  // ortak kok dizini yukari tasir ve derleme ciktisi dist/main.js yerine
  // dist/src/main.js olur. Seed'i ts-node calistirdigi icin derleme
  // ciktisinda bulunmasi gerekmiyor.
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
