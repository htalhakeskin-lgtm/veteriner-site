# apps/api/.env.example -> .env olarak kopyala ve doldur.
# .env ASLA commit edilmez.

NODE_ENV=development
PORT=3000

# docker-compose.yml ile ayni kimlik bilgileri
DATABASE_URL="postgresql://vet:vet@localhost:5432/vetclinic?schema=public"

# Frontend adresi - CORS sadece buna izin verir
WEB_ORIGIN="http://localhost:5173"

# true iken e-posta / SMS / WhatsApp GERCEKTEN gonderilmez,
# sadece Notification tablosuna yazilir. Klinik sunumlarinda acik birakin.
DEMO_MODE=true

UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=5

# En az 32 karakter. Uretimde MUTLAKA yeni uret:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="buraya-en-az-32-karakterlik-rastgele-bir-deger"
JWT_REFRESH_SECRET="buraya-farkli-en-az-32-karakterlik-rastgele-deger"
JWT_ACCESS_TTL="15m"
REFRESH_TTL_DAYS=7
# HTTPS altinda true yapilmali
COOKIE_SECURE=false
