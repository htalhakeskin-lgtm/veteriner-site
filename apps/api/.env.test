# e2e testleri bu dosyayi kullanir. Ayri veritabani: testler gelistirme
# verisini silmesin. Sirlar test amaclidir, gercek bir sey icermez.
# apps/api/.env.example -> .env olarak kopyala ve doldur.
# .env ASLA commit edilmez.

NODE_ENV=test
PORT=3000

# docker-compose.yml ile ayni kimlik bilgileri
DATABASE_URL="postgresql://vet:vet@localhost:5432/vetclinic_test?schema=public"

# Frontend adresi - CORS sadece buna izin verir
WEB_ORIGIN="http://localhost:5173"

# true iken e-posta / SMS / WhatsApp GERCEKTEN gonderilmez,
# sadece Notification tablosuna yazilir. Klinik sunumlarinda acik birakin.
DEMO_MODE=true

UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=5

JWT_ACCESS_SECRET="-LV05gyBUSNHuoGXa-nZxp9FwvqWC7jOMkJ9RTMXmFZmCoWO-TpbREei2EZRLBwR"
JWT_REFRESH_SECRET="RAesgDaM5BnH98AQIm6K0Gc8Jawa63hEjbvCNrAlYzQ1pBXJeKq1PlJNhkzhzT9k"
JWT_ACCESS_TTL="15m"
REFRESH_TTL_DAYS=7
COOKIE_SECURE=false

# Testlerde hiz siniri kapali; kendisi throttle.e2e-spec.ts icinde olculuyor
THROTTLE_ENABLED=false
